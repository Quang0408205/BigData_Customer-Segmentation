# Copy file này thành .env và chỉnh giá trị cho máy của bạn.
# .env KHÔNG được commit (đã có trong .gitignore).
# Biến do docker-compose đặt cho container sẽ được ưu tiên hơn giá trị trong .env.

# ----- HDFS (Phase 2) -----
# "namenode" là hostname của service trong Docker network.
# 8020 = cổng RPC mặc định của NameNode trong Hadoop 3.
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_PORT=8020

# ----- Spark (Phase 2) -----
# local[*]               = chạy Spark trên máy hiện tại (Windows .venv), dùng mọi CPU core
# spark://spark-master:7077 = Spark cluster trong Docker (docker-compose đặt sẵn cho container)
SPARK_MASTER_URL=local[*]
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
