# Cấu hình Hadoop cho image apache/hadoop.
# Script /opt/envtoconf.py trong image đổi mỗi dòng <FILE>_<key>=<value>
# thành một <property> trong file XML tương ứng khi container khởi động.

# ----- core-site.xml -----
# Địa chỉ mặc định của file system: mọi client (hdfs CLI, Spark) hỏi NameNode ở đây.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

# ----- hdfs-site.xml -----
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# Nơi NameNode lưu metadata (fsimage + edit log) và DataNode lưu block.
# /data trong CONTAINER là Docker volume (không phải đường dẫn HDFS).
HDFS-SITE.XML_dfs.namenode.name.dir=/data/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/data/dfs/data
# Chỉ có 1 DataNode -> mỗi block chỉ lưu được 1 bản.
# Để mặc định 3 thì mọi block sẽ ở trạng thái "under-replicated".
HDFS-SITE.XML_dfs.replication=1
# Kích thước block mặc định của Hadoop 3 (128 MB), ghi rõ để dễ giải thích.
HDFS-SITE.XML_dfs.blocksize=134217728
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# DataNode đăng ký bằng IP trong Docker network, không có DNS ngược -> tắt kiểm tra.
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
